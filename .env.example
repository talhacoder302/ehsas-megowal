# Copy this file to .env.local and fill in the values.

# MongoDB Atlas (required)
MONGODB_URI=
MONGODB_DB=

# Auth.js (required). Generate a secret with: npx auth secret
AUTH_SECRET=
AUTH_URL=
AUTH_TRUST_HOST=

# Public base URL of the app, e.g. https://ehsas.example.com
NEXT_PUBLIC_APP_URL=

# Cloudflare R2 for receipt photos (optional, uploads are disabled if missing)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Resend for email (optional, email is disabled if missing)
RESEND_API_KEY=
EMAIL_FROM=
